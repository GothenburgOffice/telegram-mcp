# Copy to .env next to compose.images.yaml and fill in. This server holds NO bot tokens: every
# connection sends its own (x-application-key) and its chat ID (x-application-id).

# The public host name, for the DNS-rebinding Host check.
PUBLIC_HOST=telegrammcp.example.com
APP_PORT=3440
# Required. Comma-separated MCP tokens; a connection must send one as "x-client-secret: <token>"
# (or "Authorization: Bearer <token>"). Make each with: openssl rand -hex 32
# One per person or device lets you revoke one without the others.
MCP_TOKENS=
# Sends (each message part or file) per MCP token.
RATE_PER_MINUTE=30
RATE_PER_DAY=1000
# Largest data: URL / base64 file the server forwards (https URLs are fetched by Telegram instead).
MAX_UPLOAD_MB=15
# Written by update.sh: the pinned image.
TELEGRAM_MCP_IMAGE=
